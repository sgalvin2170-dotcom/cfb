# Copy to .env and fill in. Never commit the real .env file.

# --- App client (safe to expose, but still keep out of git for tidiness) ---
# From https://instantdb.com/dash -> your app -> "App ID"
EXPO_PUBLIC_INSTANT_APP_ID=

# --- ETL / server-side only (must NOT be prefixed EXPO_PUBLIC_, never ships to the client) ---
# From https://instantdb.com/dash -> your app -> "Admin" tab
INSTANT_APP_ID=
INSTANT_APP_ADMIN_TOKEN=

# From https://collegefootballdata.com/key (free tier signup)
CFBD_API_KEY=

# Season/week the ETL should pull by default (overridable per-run)
CFB_SEASON=2026
